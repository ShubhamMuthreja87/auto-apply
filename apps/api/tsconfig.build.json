{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src",
    // Resolve @auto-apply/shared via its built dist (the workspace symlink),
    // not the source `paths` mapping used for typecheck/dev — otherwise the
    // source files land outside this project's rootDir.
    "paths": {}
  },
  "include": ["src"],
  // repo-contract.ts imports Vitest; it is test support, not shipped code.
  "exclude": ["src/**/*.test.ts", "src/repo/repo-contract.ts"]
}
