{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src",
    // Resolve @auto-apply/shared via its built dist (the workspace symlink),
    // not the source `paths` mapping used for typecheck/dev — otherwise the
    // source files land outside this project's rootDir.
    "paths": {}
  },
  "include": ["src"],
  // Test support, not shipped code (repo-contract.ts imports Vitest).
  "exclude": [
    "src/**/*.test.ts",
    "src/repo/repo-contract.ts",
    "src/discovery/recorded-fetch.ts",
    "src/auth/test-auth.ts"
  ]
}
