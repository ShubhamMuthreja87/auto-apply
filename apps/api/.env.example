# apps/api environment. Copy to apps/api/.env and fill in.
# Node >=22 loads this file in dev via tsx; in production the server reads apps/api/.env.
# Never commit the real .env (see .gitignore). Only this example is committed.

# --- Core ---
NODE_ENV=development
PORT=3001
# Firestore isolation namespace: dev locally, prod only on the server, test-* in tests.
FIRESTORE_NAMESPACE=dev

# --- Firebase (added in a later ticket) ---
# Path to the service-account key JSON, kept OUTSIDE the repo (used locally and on EC2):
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.secrets/auto-apply-sa.json
# ...or the key JSON inlined as one value (used in cloud sessions):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- AI (added in a later ticket) ---
# With no AI_API_KEY the whole run uses the keyword fallback matcher (D24).
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# AI_API_KEY=

# --- Auth + CORS (added in a later ticket) ---
# CORS_ORIGIN=http://localhost:5173
# JWT_SECRET=
# AUTH_PASSWORD_HASH=
