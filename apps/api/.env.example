# apps/api environment. Copy to apps/api/.env and fill in.
# Node >=22 loads this file in dev via tsx; in production the server reads apps/api/.env.
# Never commit the real .env (see .gitignore). Only this example is committed.

# --- Core ---
NODE_ENV=development
PORT=3001
# Firestore isolation namespace: dev locally, prod only on the server, test-* in tests.
FIRESTORE_NAMESPACE=dev

# --- Firebase ---
# Validated at boot; a missing or malformed key stops the API (ADR-0004).
# REPO=memory instead runs on a non-persistent in-memory store (never allowed
# with NODE_ENV=production); /api/health reports which repo is active.
# REPO=memory
# `npm test` also uses these to run the Firestore integration suite (in a
# throwaway test-* namespace, deleted afterwards).
# Path to the service-account key JSON, kept OUTSIDE the repo (used locally and on EC2):
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.secrets/auto-apply-sa.json
# ...or the key JSON inlined as one value, raw or base64-encoded (used in cloud sessions; wins if both are set):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Job discovery ---
# live (default): read the public Greenhouse boards; a failed board falls back to
# its recorded fixtures, labelled "fallback". fixtures: never touch the network,
# use only the recordings (deterministic e2e runs).
# JOB_SOURCE=live

# --- Matching ---
# Salary floor in lakhs per annum for the salary hard block. Optional: unset
# means the block is inactive. Compensation is never stored in the user document.
# SALARY_FLOOR_LPA=

# --- AI ---
# Any OpenAI-compatible chat-completions provider (D22); defaults shown.
# With no AI_API_KEY the whole run uses the keyword fallback matcher and the UI
# says so (D24). The key is only ever sent as the bearer token; never logged.
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# AI_API_KEY=
# Per-call timeout in ms; a timeout or invalid JSON is retried once, then that
# job falls back to the keyword matcher.
# AI_TIMEOUT_MS=20000

# --- CORS ---
# The one browser origin allowed, with credentials (D27); never `*`. Defaults to the Vite dev server.
# In production set it to https://<domain>.
# The web app has no env vars and always calls relative /api/... URLs: nginx proxies
# them in production, the Vite dev server's proxy (apps/web/vite.config.ts) in dev, so
# the browser only ever talks to its own origin and this check is a backstop.
# CORS_ORIGIN=http://localhost:5173

# --- Auth (D26) ---
# Required: the API refuses to start without all three. One user, no signup.
# Every /api route except login, logout and health needs the session cookie
# (an httpOnly; Secure; SameSite=Strict JWT, 12-hour expiry), the SSE stream included.
# The login name:
AUTH_USERNAME=
# bcrypt hash of the password, cost 12 or more. Make one with
#   npm -w @auto-apply/api run hash-password
# (reads the password from stdin). Single-quote it: the hash contains `$`.
# AUTH_PASSWORD_HASH='$2b$12$...'
AUTH_PASSWORD_HASH=
# Signs the session JWT; at least 32 characters. Make one with: openssl rand -hex 32
# Changing it signs everyone out.
JWT_SECRET=
