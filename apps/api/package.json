{
  "name": "@auto-apply/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --quiet --watch src --watch ../../packages/shared/src --ext ts --exec \"tsx --env-file-if-exists=.env src/index.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "hash-password": "tsx src/hash-password.ts",
    "record:ai": "tsx src/ai/record-ai.ts"
  },
  "dependencies": {
    "@auto-apply/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
