rules_version = '2';
// Browsers never touch Firestore: the API reads and writes through the Admin SDK, which bypasses these rules.
// If an ADR moves to direct browser reads, replace this with per-user read rules plus anonymous auth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
